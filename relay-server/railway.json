# Railway 配置
# 部署: railway login -> railway link -> railway up
# 免費額度: $5/月 credit，足夠跑小型 WebSocket 服務

{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}